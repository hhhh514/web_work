@startuml
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
package "買家功能模組" {
    [顧客註冊與登入]
    [瀏覽商品與查詢]
    [管理購物車]
    [管理願望清單]
    [建立訂單]
    [商品評論與評分]
}

package "賣家功能模組" {
    [賣家註冊與登入]
    [新增與編輯商品]
    [查看與處理訂單]
    [產生銷售報表]
    [查詢顧客評論]
}

package "商品與交易模組" {
    [商品資料管理]
    [庫存自動更新]
    [訂單管理]
    [訂單項目處理]
    [交易記錄與結帳]
}
[建立訂單] --> [庫存自動更新]
[新增與編輯商品] --> [商品資料管理]
[建立訂單] --> [訂單管理]
[訂單管理] --> [訂單項目處理]
[訂單項目處理] --> [交易記錄與結帳]
[產生銷售報表] --> [交易記錄與結帳]

@enduml
